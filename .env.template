# forcingkit environment variables
# Copy this file to .env and fill in your credentials.
# A docker-compose service can load it with env_file.

# No credentials are required: HRRR, NOAA OFS, NECOFS, HYCOM, NDBC, CO-OPS and the
# USGS Water Data APIs are all served without authentication.

# Optional USGS Water Data API key (free from https://api.waterdata.usgs.gov/signup/).
# Without it, river discharge requests still work at a lower hourly rate limit.
# USGS_API_KEY=

# Cache root for every store (default ~/.cache/forcingkit). The old name
# ECODATA_CACHE_CACHE_DIR is still read, with a warning, until the next release.
# FORCINGKIT_CACHE_DIR=~/.cache/forcingkit

# Threads for parallel OPeNDAP reads (default 4; was ECODATA_CACHE_MAX_WORKERS).
# FORCINGKIT_MAX_WORKERS=4

# The topobathykit elevation service (default http://localhost:9595; was TOPOBATHYSIM_URL).
# TOPOBATHYKIT_URL=http://localhost:9595
